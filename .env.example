# ==========================================
# HealthAssist AI - Environment Template
# Copy to backend/.env before starting the API
# ==========================================

APP_NAME="HealthAssist AI"
APP_ENV="development"
DEBUG=false

# PostgreSQL 18 Connection
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/healthcare_assistant"

# JWT Security (Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY="CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
EXPOSE_DEV_RESET_TOKEN=false

# CORS Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# File Upload Storage
UPLOAD_DIR="storage/reports"
MAX_UPLOAD_SIZE_MB=10

# AI Engine Configuration
# Options: auto | gemini | openai_compatible | llamacpp | ollama
AI_PROVIDER="auto"
AI_TIMEOUT_SECONDS=45
AI_MAX_CONTEXT_MESSAGES=14

# Google Gemini Cloud AI (RECOMMENDED - Free API key at https://aistudio.google.com/)
# Set your Gemini API key below to enable instant, high-quality cloud AI responses.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# llama.cpp local server (optional local offline engine on macOS 13 Intel x86_64)
LLAMACPP_BASE_URL="http://127.0.0.1:8080"
LLAMACPP_MODEL="qwen2.5-1.5b-instruct-q4_k_m"

# Ollama local server (optional local engine on macOS 14+)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:1.5b"

# Generic OpenAI-compatible endpoint (optional alternative e.g. Groq, DeepSeek, OpenAI)
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# Optional SMTP Email Delivery (Password Reset & Appointment Notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true

# Optional Public Support Contact Details
SUPPORT_EMAIL=""
SUPPORT_PHONE=""
SUPPORT_ADDRESS=""

# Secure Operational Keys (No Admin UI; used for verified doctor invitations & hospital maintenance)
DOCTOR_ONBOARDING_KEY=""
HOSPITAL_MAINTENANCE_KEY=""

# Frontend Environment (copy to frontend/.env if customizing)
VITE_API_BASE_URL="http://localhost:8000/api"
