# Environment Configuration Template for HealthAssist AI Backend
# Copy to .env and configure values

# Database Connection (PostgreSQL 14+)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/healthcare_assistant

# Security & Session Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPOSE_DEV_RESET_TOKEN=false

# Google Gemini Cloud AI Integration (Official SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Generic OpenAI-compatible endpoint (Optional fallback)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Public Support & Contact Email
SUPPORT_EMAIL=nslohitha2924@gmail.com
SUPPORT_PHONE=
SUPPORT_ADDRESS=
SUPPORT_FROM_NAME="HealthAssist AI"

# SMTP Outbound Email Delivery (For Contact Support Form)
# Gmail SMTP Example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_gmail@gmail.com
# SMTP_PASSWORD=your_16_character_app_password
# SMTP_FROM_EMAIL=your_gmail@gmail.com
# SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
